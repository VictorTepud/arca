%% crates-f0-f1-r2.mmd — capas y dependencias del workspace F0-F1 (r2)
%% Regenéralo con: npx -y @mermaid-js/mermaid-cli -i crates-f0-f1-r2.mmd
graph TD
    subgraph L0["L0 · cimientos compartidos"]
        log["arca-log<br/>mini-logger estilo tracing"]
        ipc["arca-ipc<br/>protocolo AIPC (tramas tag+len)"]
    end
    subgraph L1["L1 · lado de la sub-app"]
        rt["arca-rt<br/>runtime del hijo"]
        ping["bin: arca-ping<br/>dev.arca.ping (serve/panic/hang)"]
    end
    subgraph L2["L2 · lado del supervisor"]
        exec["arca-exec-native<br/>spawn + sandbox + vigilancia"]
        e2e["test: e2e.rs<br/>6 pruebas del motor"]
    end

    rt --> log
    rt --> ipc
    ping --> rt
    exec --> log
    exec --> ipc
    e2e --> exec
    e2e -. "lanza (fork+exec)" .-> ping
