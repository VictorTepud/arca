%% motor-nativo-f0-f1-r2.mmd — flujo del motor nativo y las 2 correcciones de la r2
%% Regenéralo con: npx -y @mermaid-js/mermaid-cli -i motor-nativo-f0-f1-r2.mmd
flowchart TD
    T["cargo test -p arca-exec-native --test e2e"] --> S["spawn::lanzar"]

    subgraph SPAWN["spawn.rs"]
        S --> S1["socketpair AF_UNIX<br/>(fd 3 = canal AIPC)"]
        S1 --> S2["fork + exec<br/>pre_exec: dup2 fd3 +<br/>no_new_privs + rlimit 256"]
    end

    S2 --> H{handshake HELLO<br/>timeout 2 s}
    H -- "falla" --> HX["SIGKILL + error<br/>(sin fugas de fds ni zombis)"]
    H -- "ok" --> OK["spawn OK pid=N app=dev.arca.ping"]

    OK --> HILOS

    subgraph HILOS["hilos por instancia"]
        W["watch.rs · VIGÍA (novedad r2)<br/>waitpid bloqueante"]
        D1["drain.rs · stdout"]
        D2["drain.rs · stderr<br/>re-emite: app=… canal=…"]
    end

    HILOS --> PRUEBAS

    subgraph PRUEBAS["los 3 finales posibles de la sub-app"]
        direction TB
        P1["apagado limpio:<br/>SHUTDOWN → exit code 0"]
        P2["🔧 pánico:<br/>panic! en hilo main → exit 101"]
        P3["🔧 SIGKILL:<br/>kill -9 → MuertoPorSenal(9)"]
    end

    P1 --> E1["Evento::Salida{code}"]
    P2 --> E2["Evento::Salida{101}"]
    P3 --> E3["Evento::MuertoPorSenal{9}"]

    E1 & E2 & E3 --> R["el vigía recolecta (reap)<br/>→ nunca quedan zombis"]
