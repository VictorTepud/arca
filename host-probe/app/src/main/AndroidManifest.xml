<?xml version="1.0" encoding="utf-8"?>
<!--
  host-probe — manifest del gate GO/NO-GO (T02) + probe visual F3a.

  Sin permisos: el probe solo escribe en su propio filesDir y lanza un hijo
  con el mismo UID. LA GRIETA vive en targetSdk 28 (build.gradle.kts):
  dominio SELinux untrusted_app_27 → exec de ELF en /data/data permitido
  (blueprint docs/01-restricciones-android.md §2). r11: esa misma grieta es
  la que permite “abrir binario desde el almacenamiento” (copia a
  filesDir/exec + chmod + fork+exec).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.ArcaHome">

        <!-- Lanzador (r11): grid de apps instaladas + FAB "+" para abrir
             binarios del almacenamiento (SAF). Sin demo incorporada. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- F3a: visor del probe visual. Vertical fijo a propósito: el
             framebuffer se dimensiona UNA vez al arrancar y una rotación a
             mitad de sesión invalidaría la geometría compartida con el hijo.
             r11: barra de notificaciones VISIBLE + fb 1:1 con la superficie
             real; el binario llega en el extra "bin" (lanzador o
             ./arca.sh run, que lo sube por run-as).
             exported="true" para que `./arca.sh run` (adb, uid 2000) pueda
             lanzarla directamente; es una app de desarrollo sin datos
             sensibles, el costo de exponerla es aceptable. -->
        <activity
            android:name=".DemoActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ArcaView"
            android:exported="true" />
    </application>

</manifest>
