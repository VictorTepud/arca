<?xml version="1.0" encoding="utf-8"?>
<!--
  host-probe — manifest del gate GO/NO-GO (T02) + probe visual F3a.

  Sin permisos: el probe solo escribe en su propio filesDir y lanza un hijo
  con el mismo UID. LA GRIETA vive en targetSdk 28 (build.gradle.kts):
  dominio SELinux untrusted_app_27 → exec de ELF en /data/data permitido
  (blueprint docs/01-restricciones-android.md §2).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@style/Theme.ArcaProbe">

        <!-- configChanges: la Activity no se recrea al rotar (el estado del
             probe en pantalla sobrevive; el proceso hijo no se relanza). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- F3a: probe visual. Vertical fijo a propósito: el framebuffer se
             dimensiona UNA vez al arrancar y una rotación a mitad de sesión
             invalidaría la geometría compartida con el hijo. -->
        <activity
            android:name=".DemoActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
    </application>

</manifest>
